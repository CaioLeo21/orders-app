# Copie para .env e ajuste. Nunca versione o .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres do docker-compose.yml (docker compose up -d db)
DATABASE_URL="postgresql://ipackage:ipackage@localhost:5432/ipackage?schema=public"

# HS256, pelo menos 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Origens do front liberadas no CORS (separadas por vírgula)
FRONTEND_ORIGIN=http://localhost:8080
# Cookie de sessão com Secure (padrão: true só em produção)
# COOKIE_SECURE=false
# Atrás de proxy reverso (ex.: 1)
# TRUST_PROXY=1

# URL pública da API (usada nas URLs assinadas do storage local)
PUBLIC_API_URL=http://localhost:3000

# Storage de fotos e assinaturas: local (disco, dev) ou s3 (S3/R2/MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=ipackage
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=ipackage
# STORAGE_SECRET_KEY=ipackage-secret
